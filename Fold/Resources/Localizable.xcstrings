    "login_server_explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in on your server’s page, then tap Finish. Umbrel may open its login first; Tube Archivist may also require its own login. Only the resulting session is saved on this device."
